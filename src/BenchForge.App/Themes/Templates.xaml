<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:BenchForge.App.ViewModels"
                    xmlns:v="clr-namespace:BenchForge.App.Views"
                    xmlns:c="clr-namespace:BenchForge.App.Controls">
    <c:BoolToVisibility x:Key="Vis" />
    <c:BoolToVisibility x:Key="NotVis" Invert="True" />
    <c:SeverityToBrush x:Key="SevBrush" />
    <c:StatusToBrush x:Key="StatusBrush" />
    <c:StatusToText x:Key="StatusText" />
    <c:FractionToWidth x:Key="FracWidth" />
    <c:TempToBrush x:Key="TempBrush" />

    <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:RunSetupViewModel}"><v:RunSetupView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:LiveRunViewModel}"><v:LiveRunView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ResultsViewModel}"><v:ResultsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><v:HistoryView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CompareViewModel}"><v:CompareView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CrashesViewModel}"><v:CrashesView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:EventsViewModel}"><v:EventsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>

    <!-- Shared: a headline metric tile with sparkline -->
    <DataTemplate x:Key="TileTemplate" DataType="{x:Type vm:MetricTile}">
        <Border Style="{StaticResource Card}" Width="196" Margin="0,0,10,10" Padding="12,10" Visibility="{Binding HasValue, Converter={StaticResource Vis}}">
            <StackPanel>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" />
                <TextBlock Text="{Binding Display}" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" Margin="0,2,0,4" />
                <c:Sparkline Height="30" Values="{Binding History}" Version="{Binding Version}" Stroke="{Binding Brush}" MaxValue="{Binding MaxValue}" />
                <TextBlock Text="{Binding Range}" Style="{StaticResource Label}" FontSize="10.5" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Shared: a chart card fed by a MetricChart -->
    <DataTemplate x:Key="ChartCard" DataType="{x:Type vm:MetricChart}">
        <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="12">
            <c:LineChart Title="{Binding Title}" Unit="{Binding Unit}" Series="{Binding Series}" YMin="{Binding YMin}" YMax="{Binding YMax}" Height="210" />
        </Border>
    </DataTemplate>

    <!-- Shared: recommendation card -->
    <DataTemplate x:Key="RecTemplate">
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Background="{Binding Severity, Converter={StaticResource SevBrush}}" CornerRadius="8,0,0,8" />
                <StackPanel Grid.Column="1" Margin="14,12">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14.5" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,3,0,6" />
                    <ItemsControl ItemsSource="{Binding Actions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource Accent}" Margin="0,4,0,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Shared: finding row -->
    <DataTemplate x:Key="FindingTemplate">
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Ellipse Width="9" Height="9" Fill="{Binding Severity, Converter={StaticResource SevBrush}}" VerticalAlignment="Top" Margin="0,6,0,0" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Visibility="{Binding Detail, Converter={StaticResource Vis}}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SignalTemplate">
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}" Style="{StaticResource Label}" FontFamily="{StaticResource MonoFont}" Margin="0,2,0,0" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="BulletTemplate">
        <Grid Margin="0,2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <TextBlock Text="•" Foreground="{StaticResource Accent}" />
            <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
