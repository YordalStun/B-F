<Window x:Class="BenchForge.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BenchForge overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowActivated="False"
        FontFamily="{StaticResource MonoFont}">
    <Border Background="#D90F1317" BorderThickness="1" CornerRadius="8" Padding="12,9" Cursor="SizeAll">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="#66FF7A3D" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding OnBattery}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Warn}" /></DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource Muted}" Cursor="Hand" Margin="10,2,0,0" MouseLeftButtonUp="Close_Click" ToolTip="Hide overlay" />
                <TextBlock Text="{Binding OverlayLine1}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="12.5" />
            </DockPanel>
            <TextBlock Text="{Binding OverlayCpu}" Foreground="{StaticResource Fg}" FontSize="13" Margin="0,4,0,0" />
            <TextBlock Text="{Binding OverlayGpu}" Foreground="{StaticResource Fg}" FontSize="13" />
            <TextBlock Text="{Binding OverlayRam}" Foreground="{StaticResource Fg}" FontSize="13" />
            <TextBlock Text="{Binding OverlayExtra}" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,3,0,0" />
        </StackPanel>
    </Border>
</Window>
