<UserControl x:Class="BenchForge.App.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BenchForge.App.Controls">
    <ScrollViewer Padding="20,16">
        <StackPanel>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Export for AI" Command="{Binding ExportForAiCommand}" Margin="0,0,8,0" />
                    <Button Content="Ask AI" Command="{Binding AskAiCommand}" Margin="0,0,8,0" />
                    <Button Content="Export report (HTML)" Command="{Binding ExportHtmlCommand}" />
                </StackPanel>
                <TextBlock Text="Compare runs" Style="{StaticResource H1}" />
            </DockPanel>
            <TextBlock Text="{Binding CaseText}" Style="{StaticResource MutedText}" Margin="0,4,0,12" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="{Binding HasPattern, Converter={StaticResource Vis}}" BorderBrush="{StaticResource Accent}">
                <StackPanel>
                    <TextBlock Text="Pattern found" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding Verdict}" Style="{StaticResource H2}" FontSize="19" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingTemplate}" />
                    <TextBlock Text="What to do next" Style="{StaticResource Label}" Margin="0,12,0,4" Visibility="{Binding NextSteps.Count, Converter={StaticResource Vis}}" />
                    <ItemsControl ItemsSource="{Binding NextSteps}" ItemTemplate="{StaticResource BulletTemplate}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Side by side" Style="{StaticResource H2}" />
            <TextBlock Text="Percentages compare each run with the first (oldest) one. Green = better, red = worse." Style="{StaticResource MutedText}" Margin="0,0,0,8" />
            <Border Style="{StaticResource Card}" Padding="0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid x:Name="Table" Margin="12" />
                </ScrollViewer>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
