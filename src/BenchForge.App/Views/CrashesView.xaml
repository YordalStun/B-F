<UserControl x:Class="BenchForge.App.Views.CrashesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BenchForge.App.Controls">
<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <c:ViewportPanel MinViewportHeight="620" Margin="20,16">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Crashes" Style="{StaticResource H1}" />
            <TextBlock Text="Blue screens, sudden reboots and freezes recorded by Windows, plus crashes that happened during BenchForge tests (with sensor data from the last seconds)." Style="{StaticResource MutedText}" Margin="0,2,0,12" />
            <WrapPanel>
                <TextBlock Text="Look back" VerticalAlignment="Center" Margin="0,0,8,6" />
                <ComboBox Width="110" ItemsSource="{Binding DayOptions}" SelectedItem="{Binding Days}" ItemStringFormat="{}{0} days" Margin="0,0,14,6" />
                <Button Content="Compare last two crashes" Style="{StaticResource PrimaryButton}" Command="{Binding CompareLastTwoCommand}" Margin="0,0,8,6" />
                <Button Content="Compare selected" Command="{Binding CompareSelectedCommand}" Margin="0,0,8,6" />
                <Button Content="Export for AI" Command="{Binding ExportForAiCommand}" Margin="0,0,8,6" />
                <Button Content="Ask AI" Command="{Binding AskAiCommand}" Margin="0,0,8,6" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,6" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,6" />
            </WrapPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" BorderBrush="{StaticResource Accent}" Margin="0,8,0,12" Visibility="{Binding PatternVerdict, Converter={StaticResource Vis}}">
            <StackPanel>
                <TextBlock Text="{Binding PatternVerdict}" Style="{StaticResource H2}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding PatternFindings}" ItemTemplate="{StaticResource FindingTemplate}" />
                <ItemsControl ItemsSource="{Binding PatternSteps}" ItemTemplate="{StaticResource BulletTemplate}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <c:AdaptiveSplit Grid.Row="2" Breakpoint="880" FixedWidth="380" FixedChild="0" NarrowFirstRatio="0.4">
            <Border Style="{StaticResource Card}" Padding="8">
                <ListBox x:Name="List" ItemsSource="{Binding Crashes}" SelectedItem="{Binding Selected}" SelectionMode="Extended" SelectionChanged="List_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Label}"><Run Text="{Binding Time, StringFormat=ddd d MMM yyyy HH:mm, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Source, Mode=OneWay}" /></TextBlock>
                                <TextBlock Style="{StaticResource Label}" Foreground="{StaticResource Accent}" Visibility="{Binding Suspect, Converter={StaticResource Vis}}"><Run Text="Likely: " /><Run Text="{Binding Suspect, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer>
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Open test result" Command="{Binding OpenRunCommand}" Visibility="{Binding Selected.Run, Converter={StaticResource Vis}}" />
                            <TextBlock Text="{Binding DetailTitle}" Style="{StaticResource H2}" TextWrapping="Wrap" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Explanation}" ItemTemplate="{StaticResource BulletTemplate}" />
                        <TextBlock Text="What to try" Style="{StaticResource Label}" Margin="0,12,0,4" Visibility="{Binding Fixes.Count, Converter={StaticResource Vis}}" />
                        <ItemsControl ItemsSource="{Binding Fixes}" ItemTemplate="{StaticResource BulletTemplate}" />
                        <TextBlock Text="Windows events" Style="{StaticResource Label}" Margin="0,12,0,4" />
                        <ItemsControl ItemsSource="{Binding Signals}" ItemTemplate="{StaticResource SignalTemplate}" />
                        <TextBlock Text="Crash dumps" Style="{StaticResource Label}" Margin="0,12,0,4" Visibility="{Binding Dumps.Count, Converter={StaticResource Vis}}" />
                        <ItemsControl ItemsSource="{Binding Dumps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4">
                                        <Button DockPanel.Dock="Right" Content="Deep analyze" Padding="10,4"
                                                Command="{Binding DataContext.DeepAnalyzeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Path}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource Label}"><Run Text="Stop code " /><Run Text="{Binding BugCheckHex, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding DeepAnalysis, Mode=OneWay}" /></TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </c:AdaptiveSplit>
    </Grid>
    </c:ViewportPanel>
    </ScrollViewer>
</UserControl>
