<UserControl x:Class="BenchForge.App.Views.LiveRunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BenchForge.App.Controls">
    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- Progress header -->
        <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding PlanName}" Style="{StaticResource Label}" FontSize="13" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                        <TextBlock Text="{Binding RemainingText}" FontFamily="{StaticResource DisplayFont}" FontSize="44" FontWeight="Bold" />
                        <TextBlock Text=" left" FontSize="20" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="4,0,0,9" />
                        <TextBlock Text="{Binding FinishText}" FontSize="15" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="22,0,0,10" />
                    </StackPanel>
                    <ProgressBar Value="{Binding Overall, Mode=OneWay}" Maximum="1" Height="14" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ElapsedText}" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding OverallText}" Style="{StaticResource Label}" />
                    </DockPanel>
                    <TextBlock Text="{Binding StepName}" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding StepCounter}" Style="{StaticResource Label}" />
                    <ProgressBar Value="{Binding StepFraction, Mode=OneWay}" Maximum="1" Height="6" Margin="0,6,0,4" Foreground="{StaticResource Blue}" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding StepRemaining}" Style="{StaticResource Label}" />
                        <ItemsControl ItemsSource="{Binding Phases}">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Label}" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Top">
                    <Border CornerRadius="8" Padding="16,10" Margin="0,0,0,10" Background="{StaticResource Panel2}">
                        <StackPanel>
                            <TextBlock Text="Errors found" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding ErrorCount}" FontSize="30" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}" />
                        </StackPanel>
                    </Border>
                    <Button Content="Overlay on/off" Command="{Binding ToggleOverlayCommand}" Margin="0,0,0,8" />
                    <Button Content="Stop test" Style="{StaticResource DangerButton}" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>
            <ScrollViewer Padding="0,0,14,0">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource TileTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Charts}" ItemTemplate="{StaticResource ChartCard}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="12">
                        <c:LineChart Title="Test speed (FPS, MB/s, points/s)" Series="{Binding TestMetric}" Height="220" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Steps, errors, log -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
                <TabControl>
                    <TabItem Header="Steps">
                        <ListBox ItemsSource="{Binding Steps}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="13" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Parts}" Style="{StaticResource Label}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Duration}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="Errors">
                        <ListBox ItemsSource="{Binding Errors}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Foreground="{StaticResource Bad}" TextWrapping="Wrap"><Run Text="{Binding Time, StringFormat=HH:mm:ss}" /><Run Text=" " /><Run Text="{Binding Message}" /></TextBlock>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Label}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="Log">
                        <ListBox ItemsSource="{Binding Log}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" FontSize="12"><Run Text="{Binding Time, StringFormat=HH:mm:ss}" Foreground="{StaticResource Muted}" /><Run Text=" " /><Run Text="{Binding Message}" /></TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
