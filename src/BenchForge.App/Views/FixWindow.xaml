<Window x:Class="BenchForge.App.Views.FixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BenchForge fix" Height="520" Width="760" Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        FontFamily="{StaticResource UiFont}" WindowStartupLocation="CenterOwner" Icon="/Assets/benchforge.ico">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TitleText" Style="{StaticResource H1}" FontSize="21" TextWrapping="Wrap" />
            <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" Margin="0,4,0,10" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SpotFixButton" Content="Repair at next restart" Visibility="Collapsed" Click="SpotFix_Click" Margin="0,0,8,0" />
            <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" />
            <Button x:Name="CloseButton" Content="Close" Click="Close_Click" IsEnabled="False" />
        </StackPanel>
        <TextBox x:Name="Output" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="12" Background="{StaticResource Panel}" />
    </DockPanel>
</Window>
