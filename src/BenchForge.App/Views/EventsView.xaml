<UserControl x:Class="BenchForge.App.Views.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BenchForge.App.Controls">
<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <c:ViewportPanel MinViewportHeight="640" Margin="20,16">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Event Viewer" Style="{StaticResource H1}" />
            <TextBlock Text="Ask for what you want in plain words — e.g. “all bluescreens” or “gpu crashes last week”. Works offline." Style="{StaticResource MutedText}" Margin="0,2,0,12" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Search" Command="{Binding AskCommand}" CommandParameter="{x:Null}" Margin="8,0,0,0" Padding="20,8" />
                <TextBox x:Name="AskBox" Text="{Binding AskText, UpdateSourceTrigger=PropertyChanged}" FontSize="15" Padding="10,8" KeyDown="AskBox_KeyDown" />
            </DockPanel>
            <WrapPanel Margin="0,8,0,0">
                <TextBlock Text="Try:" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,6" />
                <ItemsControl ItemsSource="{Binding Examples}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ChipButton}" Content="{Binding}" Command="{Binding DataContext.AskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>
            <WrapPanel Margin="0,4,0,0">
                <TextBlock Text="Categories:" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,6" />
                <ItemsControl ItemsSource="{Binding Presets}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ChipButton}" Content="{Binding Title}" ToolTip="{Binding Description}"
                                    Command="{Binding DataContext.PresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>
            <WrapPanel Margin="0,4,0,8">
                <ComboBox Width="150" ItemsSource="{Binding Ranges}" SelectedItem="{Binding Range}" DisplayMemberPath="Label" Margin="0,0,14,6" />
                <CheckBox Content="Critical" IsChecked="{Binding Critical}" />
                <CheckBox Content="Error" IsChecked="{Binding Error}" />
                <CheckBox Content="Warning" IsChecked="{Binding Warning}" />
                <CheckBox Content="Information" IsChecked="{Binding Information}" />
                <TextBox Width="200" Text="{Binding TextFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Text, source or event ID" Margin="0,0,8,6" />
                <Button Content="Filter" Command="{Binding FilterCommand}" Margin="0,0,8,6" />
                <Button Content="Export for AI" Command="{Binding ExportForAiCommand}" Margin="0,0,8,6" />
                <Button Content="Ask AI about these" Command="{Binding AskAiCommand}" Margin="0,0,8,6" />
            </WrapPanel>
            <TextBlock Text="{Binding Description}" FontWeight="SemiBold" Margin="0,0,0,8" />
        </StackPanel>
        <c:AdaptiveSplit Grid.Row="1" Breakpoint="950" FixedWidth="380" FixedChild="1" NarrowFirstRatio="0.6">
            <DataGrid ItemsSource="{Binding Events}" SelectedItem="{Binding Selected}" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="140" />
                    <DataGridTextColumn Header="Level" Binding="{Binding LevelName}" Width="85" />
                    <DataGridTextColumn Header="Source" Binding="{Binding Provider}" Width="*" />
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55" />
                    <DataGridTextColumn Header="Summary" Binding="{Binding FirstLine}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer>
                    <StackPanel>
                        <TextBlock Text="What this means" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,4,0,14" FontSize="13.5" />
                        <TextBlock Text="Full message" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding Selected.Message, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0,4" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </c:AdaptiveSplit>
    </Grid>
    </c:ViewportPanel>
    </ScrollViewer>
</UserControl>
