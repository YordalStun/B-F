<UserControl x:Class="BenchForge.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="26,22">
        <StackPanel>
            <TextBlock Text="Dashboard" Style="{StaticResource H1}" />
            <TextBlock Text="Live readings from every sensor on this PC, updated every second." Style="{StaticResource MutedText}" Margin="0,2,0,14" />

            <Border Visibility="{Binding SensorWarning, Converter={StaticResource Vis}}" Background="#33F0B429" BorderBrush="{StaticResource Warn}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Get PawnIO" Command="{Binding OpenPawnIoCommand}" Margin="10,0,0,0" />
                    <TextBlock Text="{Binding SensorWarning}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="{Binding CrashSummary, Converter={StaticResource Vis}}" Padding="14,10">
                <TextBlock Text="{Binding CrashSummary}" TextWrapping="Wrap" FontWeight="SemiBold" />
            </Border>
            <StackPanel Visibility="{Binding SystemChecks.Count, Converter={StaticResource Vis}}" Margin="0,0,0,6">
                <TextBlock Text="Things to check on this PC" Style="{StaticResource H2}" />
                <ItemsControl ItemsSource="{Binding SystemChecks}" ItemTemplate="{StaticResource RecTemplate}" />
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock Text="Processor" Style="{StaticResource Label}" Margin="0,3" />
                    <TextBlock Grid.Column="1" Text="{Binding CpuName}" TextWrapping="Wrap" Margin="0,3" />
                    <TextBlock Grid.Row="1" Text="Graphics" Style="{StaticResource Label}" Margin="0,3" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GpuName}" TextWrapping="Wrap" Margin="0,3" />
                    <TextBlock Grid.Row="2" Text="Memory" Style="{StaticResource Label}" Margin="0,3" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RamText}" Margin="0,3" />
                    <TextBlock Grid.Row="3" Text="Drives" Style="{StaticResource Label}" Margin="0,3" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DrivesText}" TextWrapping="Wrap" Margin="0,3" />
                    <TextBlock Grid.Row="4" Text="Motherboard" Style="{StaticResource Label}" Margin="0,3" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding BoardText}" Margin="0,3" />
                    <TextBlock Grid.Row="5" Text="Windows" Style="{StaticResource Label}" Margin="0,3" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding OsText}" Margin="0,3" />
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource TileTemplate}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Charts}" ItemTemplate="{StaticResource ChartCard}" Margin="0,4,0,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>

            <DockPanel Margin="0,10,0,8">
                <TextBox DockPanel.Dock="Right" Width="260" Text="{Binding SensorFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter sensors (e.g. 'temp', 'GPU', 'fan')" />
                <TextBlock Style="{StaticResource H2}" VerticalAlignment="Center">
                    <Run Text="All sensors" /><Run Text="{Binding SensorCount, StringFormat=' ({0})'}" Foreground="{StaticResource Muted}" />
                </TextBlock>
            </DockPanel>
            <DataGrid ItemsSource="{Binding AllSensors}" Height="460">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Hardware" Binding="{Binding Hardware}" Width="2*" />
                    <DataGridTextColumn Header="Sensor" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="*" />
                    <DataGridTextColumn Header="Now" Binding="{Binding Value}" Width="*" />
                    <DataGridTextColumn Header="Min" Binding="{Binding Min}" Width="*" />
                    <DataGridTextColumn Header="Max" Binding="{Binding Max}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
