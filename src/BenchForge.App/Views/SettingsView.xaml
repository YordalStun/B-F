<UserControl x:Class="BenchForge.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BenchForge.App.Controls">
    <ScrollViewer Padding="20,16">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,14" />

            <!-- AI -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="AI analysis (optional)" Style="{StaticResource H2}" />
                    <TextBlock Text="BenchForge always does its own built-in analysis. AI adds a written diagnosis on top. You can also export results and ask AI on another PC." Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding Providers}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:AdaptiveColumns MinItemWidth="280" MaxColumns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource OptionCard}" GroupName="ai" Command="{Binding DataContext.SelectProviderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Loaded="Provider_Loaded">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Local -->
                    <StackPanel Visibility="{Binding IsLocal, Converter={StaticResource Vis}}" Margin="0,6,0,0">
                        <TextBlock Text="Model (downloads automatically when you pick one)" Style="{StaticResource Label}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding LocalModels}" SelectedItem="{Binding SelectedModel}" MaxWidth="560" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock><Run Text="{Binding Display, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding State, Mode=OneWay}" Foreground="{StaticResource Muted}" /></TextBlock>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Label}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ProgressBar Value="{Binding DownloadFraction, Mode=OneWay}" Maximum="1" Margin="0,10,0,4" MaxWidth="560" HorizontalAlignment="Stretch" Visibility="{Binding IsDownloading, Converter={StaticResource Vis}}" />
                        <TextBlock Text="{Binding DownloadStatus}" TextWrapping="Wrap" Margin="0,4,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Download / resume" Command="{Binding DownloadCommand}" Margin="0,0,8,0" />
                            <Button Content="Pause download" Command="{Binding CancelDownloadCommand}" Margin="0,0,8,0" />
                            <Button Content="Delete model" Command="{Binding DeleteModelCommand}" />
                        </StackPanel>
                        <TextBlock Text="Models and the llama.cpp engine are stored in BenchForgeData\AI next to BenchForge.exe, so they travel with your USB stick. Uses your GPU if it can, otherwise the CPU." Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Claude -->
                    <StackPanel Visibility="{Binding IsClaude, Converter={StaticResource Vis}}" Margin="0,6,0,0">
                        <TextBlock Text="Anthropic API key (stored encrypted for this Windows user)" Style="{StaticResource Label}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <PasswordBox x:Name="KeyBox" Width="380" />
                            <Button Content="Save key" Click="SaveKey_Click" Margin="8,0,0,0" />
                            <TextBlock Text="✓ key saved" Foreground="{StaticResource Ok}" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="{Binding HasKey, Converter={StaticResource Vis}}" />
                        </StackPanel>
                        <TextBlock Text="Model" Style="{StaticResource Label}" Margin="0,10,0,4" />
                        <TextBox Width="260" HorizontalAlignment="Left" Text="{Binding ClaudeModel, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Text="Get a key at console.anthropic.com. Only a text summary of the results is sent — never crash dump files." Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Server -->
                    <StackPanel Visibility="{Binding IsServer, Converter={StaticResource Vis}}" Margin="0,6,0,0">
                        <TextBlock Text="Server address (Ollama: http://localhost:11434 · LM Studio: http://localhost:1234)" Style="{StaticResource Label}" Margin="0,0,0,4" />
                        <TextBox Width="380" HorizontalAlignment="Left" Text="{Binding ServerUrl, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Text="Model name" Style="{StaticResource Label}" Margin="0,10,0,4" />
                        <TextBox Width="260" HorizontalAlignment="Left" Text="{Binding ServerModel, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Test AI" Command="{Binding TestAiCommand}" />
                        <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap" MaxWidth="600" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Testing defaults -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Test defaults &amp; safety" Style="{StaticResource H2}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="Stop if CPU reaches" Width="180" VerticalAlignment="Center" />
                        <TextBox Width="60" Text="{Binding CpuTempLimit, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Text="°C" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="Stop if GPU reaches" Width="180" VerticalAlignment="Center" />
                        <TextBox Width="60" Text="{Binding GpuTempLimit, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Text="°C" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="RAM test uses" Width="180" VerticalAlignment="Center" />
                        <Slider Width="200" Minimum="10" Maximum="90" Value="{Binding MemoryPercent}" TickFrequency="5" IsSnapToTickEnabled="True" />
                        <TextBlock Text="{Binding MemoryPercent, StringFormat={}{0:0}% of free RAM}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="Drive test file" Width="180" VerticalAlignment="Center" />
                        <TextBox Width="80" Text="{Binding StorageFileMB, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Text="MB" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                    <CheckBox Content="Run the 3D test full screen (borderless — the overlay stays visible)" IsChecked="{Binding GpuFullscreen}" Margin="0,8,0,3" />
                    <CheckBox Content="Stop at the first calculation/memory error" IsChecked="{Binding StopOnError}" />
                    <CheckBox Content="Reopen BenchForge after a crash and show what went wrong" IsChecked="{Binding ReopenAfterCrash}" />
                    <TextBlock Text="The 3D test always renders at 1920×1080 internally, whatever the window size, so GPU scores are comparable between PCs." Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Storage &amp; sensors" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding PortableText}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                        <TextBlock Text="{Binding DataFolder}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                        <Button Content="Open" Command="{Binding OpenFolderCommand}" Margin="12,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding SensorText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
