<UserControl x:Class="BenchForge.App.Views.RunSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BenchForge.App.Controls">
<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <c:ViewportPanel MinViewportHeight="560" Margin="20,16">
    <c:AdaptiveSplit Breakpoint="880" FixedWidth="360" FixedChild="1" NarrowFirstRatio="0.58">
        <ScrollViewer Padding="0,0,18,0">
            <StackPanel>
                <TextBlock Text="Run tests" Style="{StaticResource H1}" />
                <TextBlock Text="Pick what to run. Every test is time-boxed, so you always know exactly how long is left — leave it running and come back." Style="{StaticResource MutedText}" Margin="0,2,0,12" />
                <Border Visibility="{Binding LaptopText, Converter={StaticResource Vis}}" Background="#263FA7FF" BorderBrush="{StaticResource Blue}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="Laptop mode" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Width="90" ItemsSource="{Binding LaptopModes}" SelectedItem="{Binding LaptopMode}" />
                        </StackPanel>
                        <TextBlock Text="&#xE7F8;" Style="{StaticResource Icon}" Foreground="{StaticResource Blue}" Margin="0,0,10,0" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding LaptopText}" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Presets}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:AdaptiveColumns MinItemWidth="290" MaxColumns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource OptionCard}" GroupName="preset" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14.5" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Duration -->
                <Border Style="{StaticResource Card}" Margin="0,6,0,12" Visibility="{Binding NeedsDuration, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="How long?" Style="{StaticResource H2}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="70" Text="{Binding Hours, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="hours" VerticalAlignment="Center" Margin="8,0,18,0" />
                            <TextBox Width="70" Text="{Binding Minutes, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="minutes" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="Tip: 1–2 hours finds most instability; 8+ hours (overnight) catches rare crashes." Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Burn parts -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding NeedsParts, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="Parts to load at the same time" Style="{StaticResource H2}" />
                        <WrapPanel>
                            <CheckBox Content="CPU (all threads)" IsChecked="{Binding BurnCpu}" />
                            <CheckBox Content="RAM (error test)" IsChecked="{Binding BurnRam}" />
                            <CheckBox Content="GPU (3D + VRAM)" IsChecked="{Binding BurnGpu}" />
                            <CheckBox Content="Drive (write/verify)" IsChecked="{Binding BurnDisk}" />
                        </WrapPanel>
                        <TextBlock Text="CPU + GPU together is the toughest test for your power supply and cooling." Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Single part -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding IsSingle, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Part" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox Width="140" ItemsSource="{Binding AllComponents}" SelectedItem="{Binding SingleComponent}" />
                        <TextBlock Text="Test" VerticalAlignment="Center" Margin="20,0,10,0" />
                        <ComboBox Width="140" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SingleKind}" />
                    </StackPanel>
                </Border>

                <!-- Drive health check -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding IsDrive, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="Drives to check" Style="{StaticResource H2}" />
                        <ItemsControl ItemsSource="{Binding DriveChoices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><CheckBox Content="{Binding Text}" IsChecked="{Binding IsChecked}" Margin="0,2" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Time per drive" VerticalAlignment="Center" />
                            <TextBox Width="60" Text="{Binding DriveMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="10,0,6,0" />
                            <TextBlock Text="minutes" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                   Text="The surface scan only reads (safe for your files) and covers as much of the disk as fits in the time — big hard drives need hours for a full pass. The write-cache test writes a temporary file (up to 25 % of free space) and deletes it afterwards. Run as administrator so the whole disk can be scanned." />
                    </StackPanel>
                </Border>

                <!-- Custom -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding IsCustom, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="Build your plan" Style="{StaticResource H2}" />
                        <WrapPanel>
                            <ComboBox Width="130" ItemsSource="{Binding Kinds}" SelectedItem="{Binding NewKind}" Margin="0,0,12,6" />
                            <CheckBox Content="CPU" IsChecked="{Binding NewCpu}" />
                            <CheckBox Content="RAM" IsChecked="{Binding NewRam}" />
                            <CheckBox Content="GPU" IsChecked="{Binding NewGpu}" />
                            <CheckBox Content="Drive" IsChecked="{Binding NewDisk}" />
                            <TextBox Width="60" Text="{Binding NewMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,6,6" ToolTip="Minutes (stress steps)" />
                            <TextBlock Text="min" VerticalAlignment="Center" Margin="0,0,12,6" />
                            <Button Content="Add step" Command="{Binding AddStepCommand}" Margin="0,0,6,6" />
                            <Button Content="Remove" Command="{Binding RemoveStepCommand}" Margin="0,0,6,6" />
                            <Button Content="Clear" Command="{Binding ClearStepsCommand}" Margin="0,0,6,6" />
                        </WrapPanel>
                        <ListBox ItemsSource="{Binding CustomSteps}" SelectedItem="{Binding SelectedCustomStep}" DisplayMemberPath="Text" MaxHeight="220" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Repeat the plan" VerticalAlignment="Center" />
                            <TextBox Width="60" Text="{Binding Loops, UpdateSourceTrigger=PropertyChanged}" Margin="10,0" />
                            <TextBlock Text="times" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Options -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Options" Style="{StaticResource H2}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Text="CPU stress type" VerticalAlignment="Center" Margin="0,4" />
                            <ComboBox Grid.Column="1" Width="220" HorizontalAlignment="Left" ItemsSource="{Binding StressModes}" SelectedItem="{Binding CpuStressMode}" Margin="0,4" />
                            <TextBlock Grid.Row="1" Text="RAM to test (% of free)" VerticalAlignment="Center" Margin="0,4" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                <Slider Width="200" Minimum="10" Maximum="90" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding MemoryPercent}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding MemoryPercent, StringFormat={}{0:0}%}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Text="Drive to test" VerticalAlignment="Center" Margin="0,4" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                <ComboBox Width="100" ItemsSource="{Binding Drives}" SelectedItem="{Binding StorageTarget}" />
                                <TextBox Width="80" Margin="12,0,6,0" Text="{Binding StorageFileMB, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="MB test file" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Text="Safety limits" VerticalAlignment="Center" Margin="0,4" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="CPU" VerticalAlignment="Center" />
                                <TextBox Width="56" Margin="8,0" Text="{Binding CpuTempLimit, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="°C    GPU" VerticalAlignment="Center" />
                                <TextBox Width="56" Margin="8,0" Text="{Binding GpuTempLimit, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="°C — stops the test if exceeded" VerticalAlignment="Center" Style="{StaticResource MutedText}" />
                            </StackPanel>
                            <WrapPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                <CheckBox Content="3D test full screen (borderless)" IsChecked="{Binding GpuFullscreen}" />
                                <CheckBox Content="Stop at the first error" IsChecked="{Binding StopOnError}" />
                            </WrapPanel>
                            <WrapPanel Grid.Row="5" Grid.ColumnSpan="2">
                                <CheckBox Content="If the PC crashes, reopen BenchForge after restart and show the report" IsChecked="{Binding ReopenAfterCrash}" />
                                <CheckBox Content="Show live overlay" IsChecked="{Binding ShowOverlay}" />
                            </WrapPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Plan summary -->
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Plan" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding Selected.Title}" Style="{StaticResource H2}" FontSize="20" Margin="0,2,0,4" />
                    <TextBlock Text="{Binding TotalText}" FontSize="26" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource Accent}" />
                    <TextBlock Text="{Binding FinishText}" Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding PlanWarning}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Visibility="{Binding PlanWarning, Converter={StaticResource Vis}}" Margin="0,0,0,8" />
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" Padding="14,12" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" Foreground="#15100C" VerticalAlignment="Center" />
                        <TextBlock Text="Start" Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold" Foreground="#15100C" />
                    </StackPanel>
                </Button>
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Preview}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource Label}"><Run Text="{Binding Kind}" /><Run Text=" · " /><Run Text="{Binding Parts}" /></TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Duration}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </c:AdaptiveSplit>
    </c:ViewportPanel>
    </ScrollViewer>
</UserControl>
