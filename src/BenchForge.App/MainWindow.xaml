<Window x:Class="BenchForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BenchForge" Height="860" Width="1400" MinWidth="760" MinHeight="480"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" FontFamily="{StaticResource UiFont}" FontSize="13"
        WindowStartupLocation="CenterScreen" Icon="Assets/benchforge.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="220" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Width" Value="64" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,16,0,18">
                    <Image Source="Assets/benchforge.ico" Width="30" Height="30" MouseLeftButtonUp="Logo_Click" Cursor="Hand" ToolTip="Show / hide menu labels" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold" Visibility="{Binding IsCompact, Converter={StaticResource NotVis}}">
                        <Run Text="Bench" /><Run Text="Forge" Foreground="{StaticResource Accent}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="10,10,10,14">
                    <Button Command="{Binding ExportEverythingForAiCommand}" Padding="8,7" Margin="0,0,0,10" HorizontalContentAlignment="Left"
                            ToolTip="Save one file with everything (tests, sensor data, crashes, Windows events, system info) to upload to Claude.ai or any AI">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="14" />
                            <TextBlock Text="Export all for AI" Margin="8,0,0,0" Visibility="{Binding IsCompact, Converter={StaticResource NotVis}}" />
                        </StackPanel>
                    </Button>
                    <StackPanel Visibility="{Binding IsCompact, Converter={StaticResource NotVis}}" Margin="8,0,0,0">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding AdminText}" Style="{StaticResource Label}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,6,0,0">
                        <Hyperlink Command="{Binding OpenDataFolderCommand}" Foreground="{StaticResource Muted}">Data folder</Hyperlink>
                    </TextBlock>
                    </StackPanel>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Pages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource NavButton}" GroupName="nav" IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip="{Binding Title}"
                                         Visibility="{Binding ShowInNav, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Text="{Binding Title}" Margin="12,0,0,0" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                               Visibility="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NotVis}}" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Border Visibility="{Binding Banner, Converter={StaticResource Vis}}" Background="#3AFF6B6B" BorderBrush="{StaticResource Bad}" BorderThickness="0,0,0,1" Padding="20,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissBannerCommand}" Padding="10,4" />
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Bad}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold" />
                </DockPanel>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False" />
        </Grid>
    </Grid>
</Window>
